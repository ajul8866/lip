# Required. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Database identity (defaults used by docker-compose.yml)
POSTGRES_DB=lip
POSTGRES_USER=lip

# Generate with: openssl rand -hex 24. Strongly recommended.
LIP_SETUP_TOKEN=

# Safe local-only is fail-closed. Keep true unless you have reviewed egress.
LIP_SAFE_LOCAL_ONLY=true
# Comma-separated host:port entries. Safe mode permits only loopback/private
# destinations that are explicitly listed. Example: 127.0.0.1:11434
LIP_EGRESS_ALLOWLIST=

# Set true when serving over HTTPS (directly or behind a trusted proxy).
LIP_SECURE_COOKIES=false
LIP_BIND_ADDR=127.0.0.1
LIP_MAX_CONCURRENT_TASKS=2
LIP_AUTORUN=true
LIP_DEFAULT_LOCALE=en
LIP_LOG_FORMAT=json
LIP_LOG_LEVEL=info

# Optional: API key for an OpenAI-compatible provider. Create the provider in
# Settings with apiKeyEnv=LIP_LLM_API_KEY; the key itself is never stored in
# PostgreSQL. Leave empty in safe local-only mode.
# LIP_LLM_API_KEY=

# Optional: set when running the binary outside Docker.
# DATABASE_URL=postgres://lip:${POSTGRES_PASSWORD}@127.0.0.1:5432/lip?sslmode=disable
# LIP_ADDR=:8080
# LIP_IMPORT_ROOT=./data/imports
